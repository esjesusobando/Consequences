# =============================================================================
# CONSEQUENCES — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Gemini AI (OCR, Transcription, Focus Refine) ---
# Get your key at https://aistudio.google.com/apikey
# Model used: gemini-2.5-flash
GEMINI_API_KEY=""

# --- Google OAuth (Calendar, Drive, Gmail, Tasks) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- App URL (for OAuth redirects) ---
# In development: http://localhost:3000
# In production: your deployed URL
APP_URL="http://localhost:3000"

# --- Server Configuration ---
# Port (default: 3000)
PORT="3000"
# Bind address (default: 127.0.0.1 for dev; use 0.0.0.0 for production/docker)
BIND_ADDRESS="127.0.0.1"
# Node environment: development | production
NODE_ENV="development"

# --- Notion Integration (Focus Export) ---
# Get your token at https://www.notion.so/my-integrations
NOTION_TOKEN=""
NOTION_DATABASE_ID=""

# --- Todoist Integration (Focus Export) ---
# Get your token at https://app.todoist.com/app/settings/integrations
TODOIST_TOKEN=""
